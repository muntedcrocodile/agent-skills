# Copy outside the skill checkout; default: ~/.config/agent-skills/matrix.env
# Keep the real file owner-only (chmod 600) and ignored by Git.
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_USER_ID=@notifications:example.org
# Used only by `init` to create a dedicated device. Never pass it on the CLI.
MATRIX_PASSWORD=replace-with-account-password
MATRIX_ROOM_ID=!notification-room:example.org
# Optional existing thread root; empty sends a normal room message.
MATRIX_THREAD_ID=
# Optional: defaults to ~/.local/share/agent-skills/matrix-notify
# MATRIX_NOTIFY_STATE_DIR=/absolute/private/path/matrix-notify
# Permit delivery to joined room members' unverified devices. Encryption stays on.
# Set false to require device verification in the persistent nio store.
MATRIX_ALLOW_UNVERIFIED_DEVICES=true
# Opt in only for a trusted transport, such as HTTP inside a Tailscale tunnel.
MATRIX_ALLOW_HTTP=false
