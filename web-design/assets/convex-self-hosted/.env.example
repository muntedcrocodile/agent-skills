# Run bun infra/convex/configure.ts to populate identity and a unique project name.
COMPOSE_PROJECT_NAME=
INSTANCE_NAME=
INSTANCE_SECRET=

# Compatible image baseline extracted from Behaviour; review upgrades explicitly.
CONVEX_BACKEND_IMAGE=ghcr.io/convex/convex-backend@sha256:d715e9ec088784407ca4ba2d3db592702cd328d02c76cdca3852c0018f2a76b4
NGINX_IMAGE=nginx@sha256:970364228b1e4f932abc22d321932816782cca8a20b85a77552a7cfe9acfb3b5

# Bind privately. Set browser-reachable HTTPS origins for remote deployments.
PROXY_BIND_ADDRESS=127.0.0.1
API_PORT=3210
HTTP_PORT=3211
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
